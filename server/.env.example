PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cv-builder?retryWrites=true&w=majority

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Google Gemini (https://aistudio.google.com/apikey). AI features are disabled if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
